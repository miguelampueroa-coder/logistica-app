# ENVIAZO — Environment Variables Template
# Copiar a .env.local y llenar con credenciales reales

# === DATABASE ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres

# === AUTHENTICATION ===
JWT_SECRET=your-very-long-random-secret-key-min-32-chars
JWT_EXPIRY=7d

# === PAYMENTS ===
# Stripe (optional if using)
STRIPE_API_KEY=sk_live_... (NOT sk_test_)
STRIPE_WEBHOOK_SECRET=whsec_...

# Webpay (Transbank Chile)
WEBPAY_COMMERCE_CODE=your_commerce_code
WEBPAY_API_KEY=your_api_key
WEBPAY_ENVIRONMENT=production (or integration for testing)

# === LOCATION & MAPS ===
GOOGLE_MAPS_API_KEY=AIzaSy...
MAPBOX_ACCESS_TOKEN=pk.eyJ1...

# === NOTIFICATIONS ===
# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# WhatsApp Cloud API
WHATSAPP_BUSINESS_ACCOUNT_ID=your_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
WHATSAPP_ACCESS_TOKEN=EAAxxxxxx...
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_token
WHATSAPP_WEBHOOK_SECRET=your_webhook_secret

# Email (Resend or similar)
RESEND_API_KEY=re_xxxxx...
SENDER_EMAIL=noreply@enviazo.com

# === REDIS (optional, has memory fallback) ===
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# === SERVERS ===
BACKEND_PORT=3002
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:3002

# === CORS ===
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,https://enviazo.app

# === ENVIRONMENT ===
NODE_ENV=production (development for local)
LOG_LEVEL=info (debug for development)

# === MOBILE APP (EAS) ===
EXPO_ACCOUNT_USERNAME=your_expo_username
EXPO_ACCOUNT_PASSWORD=your_expo_password
EAS_PROJECT_ID=your_eas_project_id

# === OPTIONAL: Observability ===
SENTRY_DSN=https://xxxxx@sentry.io/xxxxxx
DATADOG_API_KEY=your_datadog_key
